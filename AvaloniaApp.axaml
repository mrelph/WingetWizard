<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WingetWizard.Avalonia.App"
             RequestedThemeVariant="Default">
             
    <Application.DataTemplates>
        <!-- Add any data templates here -->
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Design Tokens -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://WingetWizard.Avalonia/Styles/DesignTokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        
        <!-- Design System -->
        <StyleInclude Source="avares://WingetWizard.Avalonia/Styles/Components.axaml"/>
        
        <!-- Legacy Styles -->
        <StyleInclude Source="avares://WingetWizard.Avalonia/Styles/ModernStyles.axaml"/>
    </Application.Styles>
</Application>
