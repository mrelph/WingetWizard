<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WingetWizard.Avalonia.ViewModels"
             xmlns:conv="using:WingetWizard.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="WingetWizard.Avalonia.Views.UpdatesPage"
             x:DataType="vm:UpdatesViewModel"
             Background="Transparent">
    
    <UserControl.Resources>
        <conv:UpdateAvailableToStatusConverter x:Key="UpdateAvailableToStatusConverter"/>
        <conv:UpdateAvailableToBrushConverter x:Key="UpdateAvailableToBrushConverter"/>
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Border Grid.Row="0" Classes="card-theme" Margin="0,0,0,16">
            <StackPanel Spacing="{StaticResource Spacing.Medium}">
                <TextBlock Classes="heading-1" Text="🔄 Update Management"/>
                <TextBlock Classes="body-1" 
                          Text="Keep your software up to date with smart update management"
                          Foreground="{StaticResource Text.Secondary}"/>
            </StackPanel>
        </Border>
        
        <!-- Controls Section -->
        <Border Grid.Row="1" Classes="card-theme" Margin="0,0,0,16">
            <StackPanel Spacing="{StaticResource Spacing.Medium}">
                <!-- Primary Actions Row -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                    <!-- Check Updates Button -->
                    <Button Grid.Column="0" 
                           Classes="primary-button"
                           Command="{Binding CheckForUpdatesCommand}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔄"/>
                            <TextBlock Text="Check Updates"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Update All Button -->
                    <Button Grid.Column="1" 
                           Classes="success-button"
                           Command="{Binding UpdateAllCommand}"
                           IsEnabled="{Binding HasUpdates}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🚀"/>
                            <TextBlock Text="Update All"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Last Checked Info -->
                    <TextBlock Grid.Column="2" 
                              Classes="body-2"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource Text.Tertiary}"
                              Margin="0,0,16,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Last checked: {0}">
                                <Binding Path="LastChecked"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <!-- Status Message -->
                    <TextBlock Grid.Column="3" 
                              Classes="body-1"
                              Text="{Binding StatusMessage}"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource Text.Secondary}"/>
                </Grid>
                
                <!-- Batch Actions Row -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" 
                      IsVisible="{Binding HasUpdates}">
                    <!-- Select All Toggle -->
                    <Button Grid.Column="0" 
                           Classes="secondary-button"
                           Command="{Binding ToggleSelectAllCommand}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="☑️"/>
                            <TextBlock Text="Toggle All"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Update Selected Button -->
                    <Button Grid.Column="1" 
                           Classes="success-button"
                           Command="{Binding UpdateSelectedCommand}"
                           IsEnabled="{Binding SelectedUpdateCount, Converter={StaticResource GreaterThanZeroConverter}}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⚡"/>
                            <TextBlock Text="Update Selected"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Clear Selection Button -->
                    <Button Grid.Column="2" 
                           Classes="secondary-button"
                           Command="{Binding ClearSelectionCommand}"
                           IsEnabled="{Binding SelectedUpdateCount, Converter={StaticResource GreaterThanZeroConverter}}"
                           Margin="0,0,16,0">
                        <TextBlock Text="Clear"/>
                    </Button>
                    
                    <!-- Selection Count -->
                    <TextBlock Grid.Column="3" 
                              Classes="body-2"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource Text.Secondary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} of {1} selected">
                                <Binding Path="SelectedUpdateCount"/>
                                <Binding Path="AvailableUpdates.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Updates List -->
        <Border Grid.Row="2" Classes="card-theme">
            <ScrollViewer>
                <StackPanel Spacing="{StaticResource Spacing.Medium}">
                    <!-- Loading indicator -->
                    <Border IsVisible="{Binding IsLoading}"
                           Padding="{StaticResource Space.Large}">
                        <StackPanel Spacing="{StaticResource Spacing.Medium}" 
                                   HorizontalAlignment="Center">
                            <TextBlock Text="⟳" FontSize="48" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Classes="body-1" 
                                      Text="Checking for updates..."
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Updates List -->
                    <ItemsControl ItemsSource="{Binding AvailableUpdates}"
                                 IsVisible="{Binding !IsLoading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card-theme" 
                                       Margin="0,0,0,8"
                                       Background="{StaticResource Surface.Secondary}">
                                    <Grid ColumnDefinitions="Auto,*,120,120,Auto">
                                        <!-- Selection Checkbox -->
                                        <CheckBox Grid.Column="0" 
                                                 IsChecked="{Binding IsSelected}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>
                                        
                                        <StackPanel Grid.Column="1" 
                                                   Spacing="{StaticResource Spacing.Small}">
                                            <TextBlock Classes="heading-3" 
                                                      Text="{Binding Name}"/>
                                            <TextBlock Classes="body-2" 
                                                      Text="{Binding Id}"
                                                      Foreground="{StaticResource Text.Secondary}"/>
                                        </StackPanel>
                                        
                                        <!-- Current Version -->
                                        <TextBlock Grid.Column="2" 
                                                  Classes="body-2" 
                                                  Text="{Binding Version}"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource Text.Tertiary}"/>
                                        
                                        <!-- Available Version -->
                                        <TextBlock Grid.Column="3" 
                                                  Classes="body-2" 
                                                  Text="{Binding Available}"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource Warning.600}"/>
                                        
                                        <!-- Actions -->
                                        <StackPanel Grid.Column="4" 
                                                   Orientation="Horizontal" 
                                                   Spacing="{StaticResource Spacing.Small}">
                                            <Button Classes="primary-button"
                                                   Content="Update"
                                                   Padding="12,6"
                                                   Command="{Binding DataContext.UpdateSinglePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Empty State -->
                    <StackPanel IsVisible="{Binding HasNoUpdates}"
                               Spacing="{StaticResource Spacing.Medium}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Space.XLarge}">
                        <TextBlock Text="✅" FontSize="64" 
                                  HorizontalAlignment="Center"
                                  Opacity="0.7"/>
                        <TextBlock Classes="heading-2" 
                                  Text="All up to date!"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Classes="body-1" 
                                  Text="No updates available at this time"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>