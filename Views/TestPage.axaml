<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WingetWizard.Avalonia.Views.TestPage">
    <StackPanel>
        <TextBlock Text="Test Page" FontSize="24" HorizontalAlignment="Center"/>
        <Button Content="Test Button" HorizontalAlignment="Center" Margin="0,20"/>
        <ListBox Name="TestListView" Height="200">
            <ListBoxItem Content="Item 1"/>
            <ListBoxItem Content="Item 2"/>
            <ListBoxItem Content="Item 3"/>
        </ListBox>
    </StackPanel>
</UserControl>

