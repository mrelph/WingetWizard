<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WingetWizard.Avalonia.ViewModels"
             xmlns:conv="using:WingetWizard.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="WingetWizard.Avalonia.Views.PackagesPage"
             x:DataType="vm:PackagesViewModel"
             Background="Transparent">
    
    <UserControl.Resources>
        <conv:UpdateAvailableToStatusConverter x:Key="UpdateAvailableToStatusConverter"/>
        <conv:UpdateAvailableToBrushConverter x:Key="UpdateAvailableToBrushConverter"/>
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <conv:InsightTypeToIconConverter x:Key="InsightTypeToIconConverter"/>
        <conv:BoolToStringConverter x:Key="BoolToStringConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Border Grid.Row="0" Classes="card-theme" Margin="0,0,0,16">
            <StackPanel Spacing="{StaticResource Spacing.Medium}">
                <TextBlock Classes="heading-1" Text="📦 Package Management"/>
                <TextBlock Classes="body-1" 
                          Text="Install, update, and manage software packages with ease"
                          Foreground="{StaticResource Text.Secondary}"/>
            </StackPanel>
        </Border>
        
        <!-- Filter Bar -->
        <Border Grid.Row="1" Classes="card-theme" Margin="0,0,0,16">
            <StackPanel Spacing="{StaticResource Spacing.Medium}">
                <!-- Primary Actions Row -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <!-- Search Container -->
                    <Border Grid.Column="0" 
                           Background="{StaticResource Surface.Secondary}" 
                           CornerRadius="{StaticResource Radius.Medium}" 
                           Padding="{StaticResource Space.Small}" 
                           Margin="0,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                    Name="SearchTextBox"
                                    Watermark="Search packages..."
                                    Text="{Binding SearchText}"
                                    Classes="search-input"/>
                            <Button Grid.Column="1" 
                                   Classes="secondary-button"
                                   Command="{Binding ClearSearchCommand}"
                                   IsVisible="{Binding HasSearchText}"
                                   Margin="4,0,0,0"
                                   Padding="8,4">
                                <TextBlock Text="✕" FontSize="10"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Filter Dropdown -->
                    <ComboBox Grid.Column="1" 
                             ItemsSource="{Binding FilterOptions}"
                             SelectedItem="{Binding SelectedFilter}"
                             MinWidth="150"
                             Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Icon}"/>
                                    <TextBlock Text="{Binding Label}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Refresh Button -->
                    <Button Grid.Column="2" 
                           Classes="primary-button"
                           Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔄"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <!-- Batch Actions Row -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" 
                      IsVisible="{Binding !IsEmpty}">
                    <!-- Toggle Select All -->
                    <Button Grid.Column="0" 
                           Classes="secondary-button"
                           Command="{Binding ToggleSelectAllCommand}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="☑️"/>
                            <TextBlock Text="Toggle All"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Bulk Install Button -->
                    <Button Grid.Column="1" 
                           Classes="success-button"
                           Command="{Binding BulkInstallCommand}"
                           IsEnabled="{Binding HasSelectedPackages}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📦"/>
                            <TextBlock Text="Install Selected"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Bulk Update Button -->
                    <Button Grid.Column="2" 
                           Classes="primary-button"
                           Command="{Binding BulkUpdateCommand}"
                           IsEnabled="{Binding HasSelectedPackages}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄"/>
                            <TextBlock Text="Update Selected"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Clear Selection Button -->
                    <Button Grid.Column="3" 
                           Classes="secondary-button"
                           Command="{Binding ClearSelectionCommand}"
                           IsEnabled="{Binding HasSelectedPackages}"
                           Margin="0,0,16,0">
                        <TextBlock Text="Clear"/>
                    </Button>
                    
                    <!-- Selection Count -->
                    <TextBlock Grid.Column="4" 
                              Classes="body-2"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource Text.Secondary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} of {1} selected">
                                <Binding Path="SelectedCount"/>
                                <Binding Path="FilteredPackages.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
                
                <!-- Bulk Operation Progress -->
                <Border IsVisible="{Binding IsBulkOperationInProgress}"
                       Background="{StaticResource Surface.Tertiary}"
                       CornerRadius="{StaticResource Radius.Small}"
                       Padding="{StaticResource Space.Medium}">
                    <StackPanel Spacing="{StaticResource Spacing.Small}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" 
                                      Classes="body-2"
                                      Text="{Binding StatusMessage}"/>
                            <TextBlock Grid.Column="1" 
                                      Classes="body-2"
                                      Foreground="{StaticResource Text.Secondary}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}/{1}">
                                        <Binding Path="BulkOperationProgress"/>
                                        <Binding Path="BulkOperationTotal"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <ProgressBar Value="{Binding BulkOperationProgress}"
                                    Maximum="{Binding BulkOperationTotal}"
                                    Height="6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        
        <!-- Packages List -->
        <Border Grid.Row="2" Classes="card-theme">
            <ScrollViewer>
                <StackPanel Spacing="{StaticResource Spacing.Medium}">
                    <!-- Loading indicator -->
                    <Border IsVisible="{Binding IsLoading}"
                           Padding="{StaticResource Space.Large}">
                        <StackPanel Spacing="{StaticResource Spacing.Medium}" 
                                   HorizontalAlignment="Center">
                            <TextBlock Text="⟳" FontSize="48" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Classes="body-1" 
                                      Text="Loading packages..."
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Package List -->
                    <ItemsControl ItemsSource="{Binding Packages}"
                                 IsVisible="{Binding !IsLoading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card-theme" 
                                       Margin="0,0,0,8"
                                       Background="{StaticResource Surface.Secondary}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Selection Checkbox -->
                                        <CheckBox Grid.Column="0" 
                                                 IsChecked="{Binding IsSelected}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>
                                        
                                        <StackPanel Grid.Column="1" 
                                                   Spacing="{StaticResource Spacing.Small}">
                                            <TextBlock Classes="heading-3" 
                                                      Text="{Binding Name}"/>
                                            <TextBlock Classes="body-2" 
                                                      Text="{Binding Id}"
                                                      Foreground="{StaticResource Text.Secondary}"/>
                                            <TextBlock Classes="caption" 
                                                      Text="{Binding Version}"
                                                      Foreground="{StaticResource Text.Tertiary}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" 
                                                   Orientation="Horizontal" 
                                                   Spacing="{StaticResource Spacing.Small}">
                                            <Button Classes="primary-button"
                                                   Content="Details"
                                                   Padding="12,6"
                                                   Command="{Binding DataContext.ShowPackageDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                            <Button Classes="secondary-button"
                                                   Content="Install"
                                                   Padding="12,6"
                                                   Command="{Binding DataContext.InstallPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Empty State -->
                    <StackPanel IsVisible="{Binding IsEmpty}"
                               Spacing="{StaticResource Spacing.Medium}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Space.XLarge}">
                        <TextBlock Text="📦" FontSize="64" 
                                  HorizontalAlignment="Center"
                                  Opacity="0.5"/>
                        <TextBlock Classes="heading-2" 
                                  Text="No packages found"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Classes="body-1" 
                                  Text="Try refreshing or adjusting your search"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>