<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WingetWizard.Avalonia.ViewModels"
             xmlns:conv="using:WingetWizard.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="WingetWizard.Avalonia.Views.PackagesPage"
             Background="Transparent">
    
    <UserControl.Resources>
        <conv:UpdateAvailableToStatusConverter x:Key="UpdateAvailableToStatusConverter"/>
        <conv:UpdateAvailableToBrushConverter x:Key="UpdateAvailableToBrushConverter"/>
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="📦 Package Management" 
                      FontSize="28" 
                      FontWeight="Bold" 
                      Foreground="White"/>
            <TextBlock Text="Install, update, and manage software packages with ease" 
                      FontSize="16" 
                      Foreground="#94A3B8" 
                      Margin="0,8,0,0"/>
        </StackPanel>
        
        <!-- Controls Section -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Box -->
            <Border Grid.Column="0" 
                   Background="#334155" 
                   CornerRadius="8" 
                   Padding="16,12" 
                   Margin="0,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="🔍" 
                              FontSize="16" 
                              Foreground="#94A3B8" 
                              VerticalAlignment="Center" 
                              Margin="0,0,12,0"/>
                    
                    <TextBox Grid.Column="1" 
                            Name="SearchBox"
                            Text="{Binding SearchQuery}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="14"
                            Watermark="Search packages..."
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Filter Dropdown -->
            <ComboBox Grid.Column="1" 
                     Name="FilterComboBox"
                     SelectedItem="{Binding SelectedFilter}"
                     ItemsSource="{Binding FilterOptions}"
                     Background="#334155"
                     Foreground="White"
                     BorderThickness="0"
                     CornerRadius="8"
                     Padding="16,12"
                     Margin="0,0,16,0"
                     MinWidth="150"/>
            
            <!-- Refresh Button -->
            <Button Grid.Column="2" 
                   Name="RefreshBtn"
                   Command="{Binding RefreshPackagesCommand}"
                   
                   Background="#4F46E5"
                   Foreground="White"
                   BorderThickness="0"
                   CornerRadius="8"
                   Padding="16,12"
                   Margin="0,0,16,0"
                   Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Refresh" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
            </Button>
            
            <!-- Load Button -->
            <Button Grid.Column="3" 
                   Name="LoadBtn"
                   Command="{Binding LoadPackagesCommand}"
                   
                   Background="#10B981"
                   Foreground="White"
                   BorderThickness="0"
                   CornerRadius="8"
                   Padding="16,12"
                   Margin="0,0,16,0"
                   Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Load" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
            </Button>
            
            <!-- Search & Install Button -->
            <Button Grid.Column="4" 
                   Name="SearchInstallBtn"
                   Command="{Binding SearchAndInstallCommand}"
                   
                   Background="#8B5CF6"
                   Foreground="White"
                   BorderThickness="0"
                   CornerRadius="8"
                   Padding="16,12"
                   Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Search &amp; Install" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Packages List -->
        <Border Grid.Row="2" 
               Background="#334155" 
               CornerRadius="8" 
               Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- List Header -->
                <Border Grid.Row="0" 
                       Background="#475569" 
                       CornerRadius="8,8,0,0" 
                       Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                  Text="Package Name" 
                                  FontWeight="SemiBold" 
                                  Foreground="White"/>
                        <TextBlock Grid.Column="1" 
                                  Text="ID" 
                                  FontWeight="SemiBold" 
                                  Foreground="White"/>
                        <TextBlock Grid.Column="2" 
                                  Text="Version" 
                                  FontWeight="SemiBold" 
                                  Foreground="White"/>
                        <TextBlock Grid.Column="3" 
                                  Text="Status" 
                                  FontWeight="SemiBold" 
                                  Foreground="White"/>
                        <TextBlock Grid.Column="4" 
                                  Text="Actions" 
                                  FontWeight="SemiBold" 
                                  Foreground="White"/>
                    </Grid>
                </Border>
                
                <!-- Packages ListView -->
                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto">
                    <ListBox Name="PackagesListView"
                              ItemsSource="{Binding FilteredPackages}"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Enhanced Package Card Design -->
                                <Border Background="#475569" 
                                       CornerRadius="12" 
                                       Margin="8,6" 
                                       Padding="20,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.1" OffsetY="2"/>
                                    </Border.Effect>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header Row: Name, Status Badge, Selection -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Selection Checkbox -->
                                            <CheckBox Grid.Column="0" 
                                                     IsChecked="{Binding IsSelected}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>
                                            
                                            <!-- Package Icon Placeholder -->
                                            <Border Grid.Column="1" 
                                                   Background="#64748B" 
                                                   Width="40" Height="40" 
                                                   CornerRadius="8"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center">
                                                <TextBlock Text="📦" 
                                                          FontSize="20" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Package Info -->
                                            <StackPanel Grid.Column="2" 
                                                       Orientation="Vertical" 
                                                       Margin="16,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                          FontWeight="SemiBold" 
                                                          Foreground="White" 
                                                          FontSize="16"/>
                                                <TextBlock Text="{Binding Id}" 
                                                          Foreground="#94A3B8" 
                                                          FontSize="12" 
                                                          Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="3" 
                                                   Background="{Binding Available, Converter={StaticResource UpdateAvailableToBrushConverter}}" 
                                                   CornerRadius="16" 
                                                   Padding="12,6"
                                                   VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Available, Converter={StaticResource UpdateAvailableToStatusConverter}}" 
                                                          Foreground="White" 
                                                          FontSize="11" 
                                                          FontWeight="Medium"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Version Information Row -->
                                        <Grid Grid.Row="1" Margin="52,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="Current:" 
                                                          Foreground="#CBD5E1" 
                                                          FontSize="13" 
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Version}" 
                                                          Foreground="White" 
                                                          FontSize="13" 
                                                          FontWeight="Medium"/>
                                            </StackPanel>
                                            
                                            <!-- Available Version (if exists) -->
                                            <StackPanel Grid.Column="2" 
                                                       Orientation="Horizontal"
                                                       IsVisible="{Binding Available, Converter={StaticResource StringNotEmptyConverter}}">
                                                <TextBlock Text="Available:" 
                                                          Foreground="#CBD5E1" 
                                                          FontSize="13" 
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Available}" 
                                                          Foreground="#10B981" 
                                                          FontSize="13" 
                                                          FontWeight="Medium"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- Status Message Row (if any) -->
                                        <Border Grid.Row="2" 
                                               Background="#374151" 
                                               CornerRadius="6" 
                                               Padding="12,8" 
                                               Margin="52,0,0,12"
                                               IsVisible="{Binding Status, Converter={StaticResource StringNotEmptyConverter}}">
                                            <TextBlock Text="{Binding Status}" 
                                                      Foreground="#9CA3AF" 
                                                      FontSize="12"/>
                                        </Border>
                                        
                                        <!-- Action Buttons Row -->
                                        <StackPanel Grid.Row="3" 
                                                   Orientation="Horizontal" 
                                                   HorizontalAlignment="Right"
                                                   Spacing="8">
                                            
                                            <!-- Update Button (visible if update available) -->
                                            <Button Background="#3B82F6"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="8"
                                                    Padding="16,8"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    IsVisible="{Binding Available, Converter={StaticResource StringNotEmptyConverter}}"
                                                    Command="{Binding $parent[UserControl].((vm:PackagesViewModel)DataContext).UpgradePackageCommandCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="⬆️" FontSize="12"/>
                                                    <TextBlock Text="Update"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <!-- Install Button (for search results) -->
                                            <Button Background="#10B981"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="8"
                                                    Padding="16,8"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Command="{Binding $parent[UserControl].((vm:PackagesViewModel)DataContext).InstallPackageCommandCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="⬇️" FontSize="12"/>
                                                    <TextBlock Text="Install"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <!-- Uninstall Button -->
                                            <Button Background="#EF4444"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="8"
                                                    Padding="16,8"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Command="{Binding $parent[UserControl].((vm:PackagesViewModel)DataContext).UninstallPackageCommandCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="🗑️" FontSize="12"/>
                                                    <TextBlock Text="Remove"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <!-- Status Footer -->
        <Border Grid.Row="3" 
               Background="#475569" 
               CornerRadius="6" 
               Padding="16,12" 
               Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="{Binding StatusMessage}" 
                          Foreground="#E2E8F0" 
                          VerticalAlignment="Center"/>
                          
                <StackPanel Grid.Column="1" 
                          Orientation="Horizontal">
                    <TextBlock Text="Total Packages:" 
                              FontSize="12" 
                              Foreground="#94A3B8" 
                              VerticalAlignment="Center" 
                              Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Packages.Count}" 
                              FontSize="12" 
                              Foreground="#10B981" 
                              FontWeight="Medium" 
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Loading Overlay -->
        <Border Name="LoadingOverlay" 
               Grid.RowSpan="4"
               Background="#80000000"
               IsVisible="{Binding IsLoading}"
               ZIndex="1000">
            <Grid>
                <Border Background="#1E293B"
                       CornerRadius="12"
                       Padding="40"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="300">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Loading Spinner -->
                        <Border Name="LoadingSpinner"
                               Width="48"
                               Height="48"
                               CornerRadius="24"
                               BorderThickness="4"
                               BorderBrush="#4F46E5"
                               Margin="0,0,0,16">
                            <Border.Styles>
                                <Style Selector="Border#LoadingSpinner">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="RenderTransform" Value="rotate(0deg)"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="RenderTransform" Value="rotate(360deg)"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                        </Border>
                        
                        <TextBlock Name="LoadingText"
                                  Text="Loading packages..."
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8"/>
                                  
                        <TextBlock Name="LoadingSubtext"
                                  Text="Please wait while we fetch the latest data"
                                  FontSize="12"
                                  Foreground="#94A3B8"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
