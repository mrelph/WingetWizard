<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WingetWizard.Avalonia.MainWindow"
        Title="WingetWizard - AI-Enhanced Package Manager"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Secondary.Brush}"
        Icon="{x:Null}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" Height="80" Background="{StaticResource Surface.Primary.Brush}" 
               BorderBrush="{StaticResource Border.Light.Brush}" BorderThickness="0,0,0,1">
            <Grid Margin="{StaticResource Space.Large}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource Spacing.Medium}">
                    <TextBlock Text="📦" FontSize="28"/>
                    <TextBlock Text="WingetWizard" 
                              FontSize="{StaticResource FontSize.H2}" 
                              FontWeight="{StaticResource FontWeight.Bold}" 
                              FontFamily="{StaticResource Font.Display}"
                              Foreground="{StaticResource Text.Primary.Brush}"/>
                    <Border Background="{StaticResource AI.Purple.100.Brush}" 
                           CornerRadius="{StaticResource Radius.Small}"
                           Padding="{StaticResource Space.Small}">
                        <TextBlock Text="AI-Enhanced" 
                                  FontSize="{StaticResource FontSize.Caption}"
                                  Foreground="{StaticResource AI.Purple.700.Brush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="{StaticResource Space.Large}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Enhanced Navigation Sidebar -->
            <Border Grid.Column="0" 
                   Background="{StaticResource Surface.Primary.Brush}"
                   CornerRadius="{StaticResource Radius.Large}"
                   Padding="{StaticResource Space.Large}"
                   Margin="0,0,16,0"
                   Effect="{StaticResource Shadow.Small}">
                <StackPanel Spacing="{StaticResource Spacing.Large}">
                    
                    <!-- Logo Section -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.Small}">
                        <TextBlock Text="📦" FontSize="20"/>
                        <TextBlock Text="Navigation" 
                                  FontSize="{StaticResource FontSize.H3}"
                                  FontWeight="{StaticResource FontWeight.Medium}"
                                  Foreground="{StaticResource Text.Primary.Brush}"/>
                    </StackPanel>
                    
                    <!-- Navigation Items -->
                    <StackPanel Spacing="{StaticResource Spacing.Small}">
                        <Button Name="DashboardBtn" Classes="primary-button" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🏠"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="PackagesBtn" Classes="secondary-button" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📦"/>
                                <TextBlock Text="Packages"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="UpdatesBtn" Classes="secondary-button" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔄"/>
                                <TextBlock Text="Updates"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="AIBtn" Classes="secondary-button" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🤖"/>
                                <TextBlock Text="AI Research"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="SettingsBtn" Classes="secondary-button" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚙️"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- User Section -->
                    <Border Background="{StaticResource Surface.Secondary.Brush}" 
                           CornerRadius="{StaticResource Radius.Medium}"
                           Padding="{StaticResource Space.Small}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="32" Height="32" 
                                   Background="{StaticResource Primary.100.Brush}" 
                                   CornerRadius="16" Margin="0,0,8,0">
                                <TextBlock Text="U" 
                                          FontSize="{StaticResource FontSize.Body}"
                                          FontWeight="{StaticResource FontWeight.Medium}"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource Primary.700.Brush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="User" 
                                          FontSize="{StaticResource FontSize.Body}"
                                          Foreground="{StaticResource Text.Primary.Brush}"/>
                                <TextBlock Text="Administrator" 
                                          FontSize="{StaticResource FontSize.Caption}"
                                          Foreground="{StaticResource Text.Secondary.Brush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" 
                   Background="{StaticResource Surface.Primary.Brush}" 
                   CornerRadius="{StaticResource Radius.Large}"
                   Effect="{StaticResource Shadow.Small}">
                <ContentControl Name="MainContentControl">
                    <!-- Default content will be Dashboard -->
                </ContentControl>
            </Border>
        </Grid>
    </Grid>

</Window>
