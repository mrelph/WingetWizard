<Styles xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Simple Button Styles -->
    <Style Selector="Button.modern-button">
        <Setter Property="Background" Value="#374151"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.modern-button:pointerover">
        <Setter Property="Background" Value="#4B5563"/>
    </Style>

    <Style Selector="Button.modern-button:pressed">
        <Setter Property="Background" Value="#6B7280"/>
    </Style>

    <!-- Primary Button -->
    <Style Selector="Button.modern-primary">
        <Setter Property="Background" Value="#4F46E5"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.modern-primary:pointerover">
        <Setter Property="Background" Value="#6366F1"/>
    </Style>

    <Style Selector="Button.modern-primary:pressed">
        <Setter Property="Background" Value="#3730A3"/>
    </Style>

    <!-- Text Input Styles -->
    <Style Selector="TextBox.modern-input">
        <Setter Property="Background" Value="#374151"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#6B7280"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBox.modern-input:focus">
        <Setter Property="BorderBrush" Value="#4F46E5"/>
    </Style>

    <!-- Status Badge Styles -->
    <Style Selector="Border.status-badge">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

</Styles>