<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography Scale -->
    <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Monospace">Consolas</FontFamily>
    
    <!-- Font Sizes -->
    <x:Double x:Key="FontSize.H1">32</x:Double>
    <x:Double x:Key="FontSize.H2">24</x:Double>
    <x:Double x:Key="FontSize.H3">18</x:Double>
    <x:Double x:Key="FontSize.Body">14</x:Double>
    <x:Double x:Key="FontSize.Small">12</x:Double>
    <x:Double x:Key="FontSize.Caption">11</x:Double>
    
    <!-- Font Weights -->
    <FontWeight x:Key="FontWeight.Light">Light</FontWeight>
    <FontWeight x:Key="FontWeight.Regular">Normal</FontWeight>
    <FontWeight x:Key="FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="FontWeight.Semibold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>
    
    <!-- Spacing Scale -->
    <Thickness x:Key="Space.Micro">4</Thickness>
    <Thickness x:Key="Space.Small">8</Thickness>
    <Thickness x:Key="Space.Medium">16</Thickness>
    <Thickness x:Key="Space.Large">24</Thickness>
    <Thickness x:Key="Space.XLarge">32</Thickness>
    
    <!-- Spacing Values (for margins, padding) -->
    <x:Double x:Key="Spacing.Micro">4</x:Double>
    <x:Double x:Key="Spacing.Small">8</x:Double>
    <x:Double x:Key="Spacing.Medium">16</x:Double>
    <x:Double x:Key="Spacing.Large">24</x:Double>
    <x:Double x:Key="Spacing.XLarge">32</x:Double>
    
    <!-- Border Radius -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">16</CornerRadius>
    
    <!-- Color Palette -->
    
    <!-- Primary Colors -->
    <Color x:Key="Primary.50">#F0F9FF</Color>
    <Color x:Key="Primary.100">#E0F2FE</Color>
    <Color x:Key="Primary.200">#BAE6FD</Color>
    <Color x:Key="Primary.300">#7DD3FC</Color>
    <Color x:Key="Primary.400">#38BDF8</Color>
    <Color x:Key="Primary.500">#0EA5E9</Color>
    <Color x:Key="Primary.600">#0284C7</Color>
    <Color x:Key="Primary.700">#0369A1</Color>
    <Color x:Key="Primary.800">#075985</Color>
    <Color x:Key="Primary.900">#0C4A6E</Color>
    
    <!-- Surface Colors -->
    <Color x:Key="Surface.Primary">#FFFFFF</Color>
    <Color x:Key="Surface.Secondary">#F8FAFC</Color>
    <Color x:Key="Surface.Tertiary">#F1F5F9</Color>
    <Color x:Key="Surface.Elevated">#FFFFFF</Color>
    
    <!-- Text Colors -->
    <Color x:Key="Text.Primary">#0F172A</Color>
    <Color x:Key="Text.Secondary">#475569</Color>
    <Color x:Key="Text.Tertiary">#94A3B8</Color>
    <Color x:Key="Text.Disabled">#CBD5E1</Color>
    
    <!-- Border Colors -->
    <Color x:Key="Border.Light">#E2E8F0</Color>
    <Color x:Key="Border.Medium">#CBD5E1</Color>
    <Color x:Key="Border.Strong">#94A3B8</Color>
    
    <!-- Status Colors -->
    <Color x:Key="Success.50">#F0FDF4</Color>
    <Color x:Key="Success.100">#DCFCE7</Color>
    <Color x:Key="Success.500">#22C55E</Color>
    <Color x:Key="Success.700">#15803D</Color>
    
    <Color x:Key="Warning.50">#FFFBEB</Color>
    <Color x:Key="Warning.100">#FEF3C7</Color>
    <Color x:Key="Warning.500">#F59E0B</Color>
    <Color x:Key="Warning.700">#B45309</Color>
    
    <Color x:Key="Error.50">#FEF2F2</Color>
    <Color x:Key="Error.100">#FEE2E2</Color>
    <Color x:Key="Error.500">#EF4444</Color>
    <Color x:Key="Error.700">#B91C1C</Color>
    
    <!-- AI Theme Colors -->
    <Color x:Key="AI.Purple.50">#FAF5FF</Color>
    <Color x:Key="AI.Purple.100">#F3E8FF</Color>
    <Color x:Key="AI.Purple.200">#E9D5FF</Color>
    <Color x:Key="AI.Purple.300">#D8B4FE</Color>
    <Color x:Key="AI.Purple.400">#C084FC</Color>
    <Color x:Key="AI.Purple.500">#A855F7</Color>
    <Color x:Key="AI.Purple.600">#9333EA</Color>
    <Color x:Key="AI.Purple.700">#7C3AED</Color>
    <Color x:Key="AI.Purple.800">#6B21A8</Color>
    <Color x:Key="AI.Purple.900">#581C87</Color>
    
    <!-- Brush Resources -->
    <SolidColorBrush x:Key="Primary.50.Brush" Color="{StaticResource Primary.50}"/>
    <SolidColorBrush x:Key="Primary.100.Brush" Color="{StaticResource Primary.100}"/>
    <SolidColorBrush x:Key="Primary.500.Brush" Color="{StaticResource Primary.500}"/>
    <SolidColorBrush x:Key="Primary.600.Brush" Color="{StaticResource Primary.600}"/>
    <SolidColorBrush x:Key="Primary.700.Brush" Color="{StaticResource Primary.700}"/>
    
    <SolidColorBrush x:Key="Surface.Primary.Brush" Color="{StaticResource Surface.Primary}"/>
    <SolidColorBrush x:Key="Surface.Secondary.Brush" Color="{StaticResource Surface.Secondary}"/>
    <SolidColorBrush x:Key="Surface.Tertiary.Brush" Color="{StaticResource Surface.Tertiary}"/>
    
    <SolidColorBrush x:Key="Text.Primary.Brush" Color="{StaticResource Text.Primary}"/>
    <SolidColorBrush x:Key="Text.Secondary.Brush" Color="{StaticResource Text.Secondary}"/>
    <SolidColorBrush x:Key="Text.Tertiary.Brush" Color="{StaticResource Text.Tertiary}"/>
    
    <SolidColorBrush x:Key="Border.Light.Brush" Color="{StaticResource Border.Light}"/>
    <SolidColorBrush x:Key="Border.Medium.Brush" Color="{StaticResource Border.Medium}"/>
    
    <SolidColorBrush x:Key="Success.500.Brush" Color="{StaticResource Success.500}"/>
    <SolidColorBrush x:Key="Warning.500.Brush" Color="{StaticResource Warning.500}"/>
    <SolidColorBrush x:Key="Error.500.Brush" Color="{StaticResource Error.500}"/>
    
    <SolidColorBrush x:Key="AI.Purple.100.Brush" Color="{StaticResource AI.Purple.100}"/>
    <SolidColorBrush x:Key="AI.Purple.500.Brush" Color="{StaticResource AI.Purple.500}"/>
    <SolidColorBrush x:Key="AI.Purple.700.Brush" Color="{StaticResource AI.Purple.700}"/>
    
    <!-- Shadow Effects -->
    <DropShadowEffect x:Key="Shadow.Small" BlurRadius="4" OffsetX="0" OffsetY="1" Color="#10000000"/>
    <DropShadowEffect x:Key="Shadow.Medium" BlurRadius="8" OffsetX="0" OffsetY="2" Color="#15000000"/>
    <DropShadowEffect x:Key="Shadow.Large" BlurRadius="16" OffsetX="0" OffsetY="4" Color="#20000000"/>
    
</ResourceDictionary>
