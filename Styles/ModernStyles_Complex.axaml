<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern Button Styles -->
    
    <!-- Primary Action Button -->
    <Style Selector="Button.action-primary">
        <Setter Property="Background" Value="#4F46E5"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.action-primary:pointerover">
        <Setter Property="Background" Value="#6366F1"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <Style Selector="Button.action-primary:pressed">
        <Setter Property="Background" Value="#3730A3"/>
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- Success Button -->
    <Style Selector="Button.action-success">
        <Setter Property="Background" Value="#10B981"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.action-success:pointerover">
        <Setter Property="Background" Value="#059669"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <!-- Warning Button -->
    <Style Selector="Button.action-warning">
        <Setter Property="Background" Value="#F59E0B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.action-warning:pointerover">
        <Setter Property="Background" Value="#D97706"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <!-- Danger Button -->
    <Style Selector="Button.action-danger">
        <Setter Property="Background" Value="#EF4444"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.action-danger:pointerover">
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <!-- Secondary Button -->
    <Style Selector="Button.action-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#374151"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.action-secondary:pointerover">
        <Setter Property="Background" Value="#374151"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="RenderTransform" Value="scale(1.01)"/>
    </Style>

    <!-- Modern Card Styles -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="#475569"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.card:pointerover">
        <Setter Property="Background" Value="#52525b"/>
        <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    </Style>

    <!-- Modern TextBox Styles -->
    <Style Selector="TextBox.modern">
        <Setter Property="Background" Value="#374151"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#4B5563"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox.modern:focus">
        <Setter Property="BorderBrush" Value="#4F46E5"/>
        <Setter Property="Background" Value="#1F2937"/>
    </Style>

    <!-- Loading Animation -->
    <Style Selector="Border.loading">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#374151" Offset="0.0" />
                <GradientStop Color="#4B5563" Offset="0.5" />
                <GradientStop Color="#374151" Offset="1.0" />
            </LinearGradientBrush>
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="translateX(-200px)"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="translateX(200px)"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Status Badge Styles -->
    <Style Selector="Border.status-badge">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.status-badge:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>

    <Style Selector="Border.status-success">
        <Setter Property="Background" Value="#10B981"/>
    </Style>

    <Style Selector="Border.status-warning">
        <Setter Property="Background" Value="#F59E0B"/>
    </Style>

    <Style Selector="Border.status-error">
        <Setter Property="Background" Value="#EF4444"/>
    </Style>

    <Style Selector="Border.status-info">
        <Setter Property="Background" Value="#3B82F6"/>
    </Style>

    <!-- Smooth Transition for all Controls -->
    <Style Selector="Control">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hover Effects for Interactive Elements -->
    <Style Selector="Border.interactive">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.interactive:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.01)"/>
    </Style>

    <Style Selector="Border.interactive:pressed">
        <Setter Property="RenderTransform" Value="scale(0.99)"/>
    </Style>

    <!-- Focus Indicators -->
    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="#4F46E5"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#4F46E5"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

</Styles>